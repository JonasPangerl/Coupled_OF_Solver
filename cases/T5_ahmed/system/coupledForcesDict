/*--------------------------------*- C++ -*----------------------------------*\
  coupledFoam test case T5 - Ahmed body: double-accumulated force
  coefficients (amendment D6, src/io/coupledForces.H). Values identical to
  functions.forceCoeffs of system/controlDict. coupledFoam evaluates them
  after every outer iteration (12.3 ii uses them); simpleFoam through the
  coupledForcesFO entry of the controlDict.
  CofR is in the mesh frame of the DP mesh; the SP harness (D5.2) shifts it
  together with the mesh (tests/cflib/precision.py).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      coupledForcesDict;
}

patches         (bodyGroup);
rhoInf          1;
magUInf         40;
lRef            1.044;
Aref            0.056016;
CofR            (0.522 0 0.194);
dragDir         (1 0 0);
liftDir         (0 0 1);
pitchAxis       (0 1 0);

