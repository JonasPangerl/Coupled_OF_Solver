/*--------------------------------*- C++ -*----------------------------------*\
  coupledFoam test case T5 - Ahmed body 25 deg, half model (spec 13).
  U_inf = 40 m/s; freestream I = 0.5 %: k = 1.5 (0.005 * 40)^2 = 0.06,
  nut/nu = 100: omega = k / nut = 40. Ground moves with U_inf.
  Body patches through their group bodyGroup; ymin (type symmetry) comes
  from setConstraintTypes and has no explicit entry.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 40;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    ground
    {
        type            omegaWallFunction;
        value           $internalField;
    }

    bodyGroup
    {
        type            omegaWallFunction;
        value           $internalField;
    }

    top
    {
        type            slip;
    }

    side
    {
        type            slip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

// ************************************************************************* //
