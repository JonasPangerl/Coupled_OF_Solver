/*--------------------------------*- C++ -*----------------------------------*\
  coupledFoam test case T0 - lid-driven cavity
  solvers.coupled : block linear solver (spec 6.1)
  coupled         : outer iteration controls, all keywords of spec 11
  SIMPLE, p, U    : native simpleFoam reference (SIMPLEC, spec 13)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    coupled
    {
        solver          blockFGMRES;    // blockFGMRES | blockGMRES | blockBiCGStab
        preconditioner  blockGAMG;      // blockDiagonal | blockGAMG
        tolerance       1e-12;  // below the outer target R < 1e-8 (D-022)
        relTol          0.05;           // used only if adaptiveRelTol no
        adaptiveRelTol  yes;            // Eisenstat-Walker (amendment B2)
        etaMin          1e-3;
        etaMax          0.5;
        gammaEW         0.9;
        alphaEW         2;
        minIter         1;
        maxIter         200;
        restart         10;             // 6 above 40 M cells (B7)
        blockGAMG
        {
            agglomerator          faceAreaPair;
            mergeLevels           2;
            nCellsInCoarsestLevel 200;
            cycleType             K;
            kCycleThreshold       0.25;
            kCycleMaxSteps        2;
            smoother              blockGaussSeidel;
            nPreSweeps            1;
            nPostSweeps           2;
            nFinestSweeps         2;
            coarsestSolver        blockBiCGStab;
            coarsestTolerance     1e-3;
            coarsestMaxIter       50;
            maxOperatorComplexity 1.5;
            cacheAgglomeration    true;
            autoTune              yes;
            tuneInterval          50;
            nPostSweepsMax        4;
        }
    }

    // Native reference solver
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-10;
        relTol          0.01;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }

    // potentialFoam initialisation (spec 7.4)
    Phi
    {
        $p;
    }
}

coupled
{
    maxIter             2000;
    potentialInit       no;     // closed cavity: potential flow is zero
    startupUpwindIters  50;
    nonOrthLimiter      0.5;
    pRefCell            0;
    pRefValue           0;

    ptc
    {
        cflStrategy     mRDM;
        CFL0            5;
        CFLmin          1;
        CFLmax          500;
        gamma           1;
        betaMax         1.5;
        betaExp         1.1;
        nHold           10;
        maxLinFails     3;      // amendment B4
    }

    lineSearch
    {
        fU              0.3;
        fp              0.5;
        omegaMin        0.1;
        kappa           0.5;
        maxCflCuts      3;
    }

    localLimit
    {
        enabled         yes;
        fLoc            0.5;
        implicit        no;     // explicit estimate of 7.3 (D-049: yes on T3)
    }

    remediation
    {
        static
        {
            enabled             yes;
            nonOrthThreshold    85;   // D-047
            skewThreshold       6;   // D-047
            volRatioThreshold   30;   // D-047
            aspectThreshold     2000;   // D-047
            beta                0;
            nonOrthLimiter      0.2;
            cflFactor           0.5;
        }
        zonal
        {
            enabled             no;     // amendment B6
        }
        dynamic
        {
            enabled             yes;
            cU                  2;
            cp                  5;
            cSpike              0.5;
            nLayers             1;
            nQuietIters         20;
            stickyAfter         3;      // never released after the 3rd entry (D-049)
            cflFactor           0.1;
            clipToNeighbourMean yes;
        }
    }

    sentinel
    {
        maxRollbacks    5;
    }

    bounds
    {
        kMin            1e-12;
        omegaMin        1e-6;
        nutMaxFactor    1e8;   // divergence guard only (D-040)
    }

    convergence
    {
        mode                any;
        forceCoeffsWindow   100;
        forceCoeffsTol      0.002;
        residualTol         1e-8;   // T0 pass criterion R < 1e-8
    }

    anderson
    {
        enabled         no;     // amendment B5
        m               4;
        beta            1.0;
    }

    ftz             yes;
    writeState      yes;
}

// Native reference: SIMPLEC, converged to 1e-8 (spec 13)
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;
    pRefCell        0;
    pRefValue       0;

    residualControl
    {
        p               1e-8;
        U               1e-8;
    }
}

relaxationFactors
{
    equations
    {
        U               0.9;
    }
}

