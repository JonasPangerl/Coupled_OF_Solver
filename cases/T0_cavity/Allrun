#!/bin/sh
#------------------------------------------------------------------------------
# T0 - lid-driven cavity 128x128 (spec 13)
#
#   ./Allrun [-solver coupledFoam|simpleFoam] [-np N] [-Re 100|1000]
#            [-mesh-only] [-keep-mesh]
#
#   -keep-mesh   use the mesh already in constant/polyMesh (no mesh
#                generation): the SP harness generates the mesh in DP and
#                shifts it (amendment D5, tests/cflib/precision.py)
#
# Defaults: coupledFoam, 1 rank, Re 100. Deterministic for a given rank count.
# Parallel runs use scotch and mpirun --bind-to core --map-by core.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions

solver=coupledFoam
np=1
Re=100
meshOnly=false
keepMesh=false

while [ "$#" -gt 0 ]
do
    case "$1" in
        -solver) solver="$2"; shift 2 ;;
        -np) np="$2"; shift 2 ;;
        -Re) Re="$2"; shift 2 ;;
        -mesh-only) meshOnly=true; shift ;;
        -keep-mesh) keepMesh=true; shift ;;
        *) echo "Unknown option $1" 1>&2; exit 1 ;;
    esac
done

# nu = U_lid L / Re with U_lid = 1, L = 0.1
nu=$(awk -v re="$Re" 'BEGIN { printf "%.10g", 0.1/re }')
foamDictionary -entry nu -set "$nu" constant/transportProperties > /dev/null
foamDictionary -entry application -set "$solver" system/controlDict > /dev/null

restore0Dir
[ "$keepMesh" = true ] || runApplication blockMesh

[ "$meshOnly" = true ] && exit 0

if [ "$np" -gt 1 ]
then
    foamDictionary -entry numberOfSubdomains -set "$np" system/decomposeParDict > /dev/null
    runApplication decomposePar -force
    # Core binding (spec 3); CF_MPI_BIND=none on a shared machine
    # Core binding (spec 3). On a shared machine: CF_MPI_CPUSET=10-15 pins the
    # ranks to that core set (disjoint from another job); CF_MPI_BIND=none
    # disables binding.
    bind="${CF_MPI_BIND:-core}"
    if [ -n "$CF_MPI_CPUSET" ]
    then
        mpiOpts="--cpu-set $CF_MPI_CPUSET --bind-to core"
    elif [ "$bind" = core ]
    then
        mpiOpts="--bind-to core --map-by core"
    else
        mpiOpts="--bind-to $bind"
    fi
    mpirun $mpiOpts -np "$np" $CF_RANK_WRAPPER "$solver" -parallel > "log.$solver" 2>&1
else
    $CF_RANK_WRAPPER "$solver" > "log.$solver" 2>&1
fi

#------------------------------------------------------------------------------
