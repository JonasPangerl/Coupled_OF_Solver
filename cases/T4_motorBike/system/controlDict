/*--------------------------------*- C++ -*----------------------------------*\
  coupledFoam test case T4 - motorBike (spec 13)
  Force coefficients: tutorial settings (forceCoeffs1 of the v2606 tutorial):
  |U_inf| = 20 m/s, lRef = 1.42 m (wheelbase), Aref = 0.75 m2 (estimated),
  CofR at the axle midpoint on the ground.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// Set by Allrun: coupledFoam or simpleFoam
application     coupledFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   1000;

purgeWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;

functions
{
    // Double-accumulated force coefficients (amendment D6), settings in
    // system/coupledForcesDict: postProcessing/coupledForces/<start>/coeffs.dat.
    // coupledFoam evaluates the same class after every outer iteration
    // itself (this entry is then dormant); simpleFoam runs it here. The
    // library is libcoupledFoam of the private install first on
    // LD_LIBRARY_PATH ($FOAM_USER_LIBBIN).
    coupledForces
    {
        type            coupledForcesFO;
        libs            (coupledFoam);
        writeControl    timeStep;
        writeInterval   1;
    }

    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             false;

        patches         (motorBikeGroup);
        rho             rhoInf;
        rhoInf          1;
        liftDir         (0 0 1);
        dragDir         (1 0 0);
        CofR            (0.72 0 0);
        pitchAxis       (0 1 0);
        magUInf         20;
        lRef            1.42;
        Aref            0.75;
    }

    // Mean fields over the averaging window of the wake criterion (D-042
    // addendum): UMean, UPrime2Mean, pMean, written at every write time.
    // The harness sets timeStart per run to n - W + 1 (n = iterations of
    // the run, W = max(1000, n/2) capped at n; bench/run_bench.py
    // field_average_start), so the average covers exactly the force window.
    // The default belongs to endTime 5000 (W 2500). simpleFoam and
    // coupledFoam both run it (same controlDict).
    fieldAverage
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        timeStart       2501;
        writeControl    writeTime;
        restartOnRestart false;
        restartOnOutput false;
        periodicRestart false;
        log             false;

        fields
        (
            U
            {
                mean        on;
                prime2Mean  on;
                base        iteration;
            }
            p
            {
                mean        on;
                prime2Mean  off;
                base        iteration;
            }
        );
    }
}

