/*--------------------------------*- C++ -*----------------------------------*\
  coupledFoam test case T3 - airFoil2D
  solvers.coupled : block linear solver (spec 6.1)
  coupled         : outer iteration controls (spec 11)
  k, omega        : native segregated turbulence solve (spec 5.8)
  SIMPLE, p, U    : native simpleFoam reference (SIMPLEC, spec 13/14)
  relaxationFactors: from system/relaxation, which Allrun copies from
                     relaxation.coupledFoam (k, omega 0.7, spec 5.8) or
                     relaxation.simpleFoam (tutorial values)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    coupled
    {
        solver          blockFGMRES;    // blockFGMRES | blockGMRES | blockBiCGStab
        preconditioner  blockGAMG;      // blockDiagonal | blockGAMG
        tolerance       1e-10;          // below R1*residualTol (D-022, D-038)
        relTol          0.05;           // used only if adaptiveRelTol no
        adaptiveRelTol  yes;            // Eisenstat-Walker (amendment B2)
        etaMin          1e-3;
        etaMax          0.5;
        gammaEW         0.9;
        alphaEW         2;
        minIter         1;
        maxIter         400;        // 200 marginally fails on stretched meshes (B4 abort on T3, 2026-09-22)
        restart         30;             // GMRES(10) stagnates (D-038); 6 above 40 M cells (B7)
        blockGAMG
        {
            agglomerator          faceAreaPair;
            agglomerationWeights  combined;   // matrix-based (D-039, D-043)
            reagglomerateInterval 50;         // D-039
            mergeLevels           2;
            nCellsInCoarsestLevel 200;   // D-043
            cycleType             V;   // grid winner (D-043)
            kCycleThreshold       0.25;
            kCycleMaxSteps        2;
            smoother              blockILU0;  // block GS keeps CFL at 1-2 (D-028, D-038)
            smootherRelaxation    0.5;   // damped ILU0 (D-043 + addendum: 0.7 aborts T2 at CFL 500)
            nPreSweeps            1;
            nPostSweeps           2;
            nFinestSweeps         2;   // D-043
            coarsestSolver        blockBiCGStab;
            coarsestTolerance     1e-3;
            coarsestMaxIter       50;
            maxOperatorComplexity 1.5;
            cacheAgglomeration    true;
            autoTune              no;   // unscaled rho misleads it (D-039)
            tuneInterval          50;
            nPostSweepsMax        4;
        }
    }

    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }

    Phi
    {
        $p;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }
}

coupled
{
    maxIter             3000;
    potentialInit       yes;
    startupUpwindIters  50;
    nonOrthLimiter      0.5;

    ptc
    {
        cflStrategy     mRDM;
        CFL0            5;
        CFLmin          1;
        CFLmax          500;
        gamma           1;
        betaMax         1.5;
        betaExp         1.1;
        nHold           10;
        maxLinFails     3;      // amendment B4
    }

    lineSearch
    {
        fU              0.3;
        fp              0.5;
        omegaMin        0.1;
        kappa           0.5;
        maxCflCuts      3;
    }

    localLimit
    {
        enabled         yes;
        fLoc            0.5;
        implicit        yes;    // Jacobi estimate: the explicit one throttles the wall cells (D-049)
    }

    remediation
    {
        static
        {
            enabled             yes;
            nonOrthThreshold    85;   // D-047
            skewThreshold       6;   // D-047
            volRatioThreshold   30;   // D-047
            aspectThreshold     2000;   // D-047
            beta                0;
            nonOrthLimiter      0.2;
            cflFactor           0.5;
        }
        zonal
        {
            enabled             no;     // amendment B6
        }
        dynamic
        {
            enabled             yes;
            cU                  4;      // local U up to 2-3x U_inf under wings (D-044)
            cp                  15;     // = cU^2-1: Cp down to -15 (suction peaks -7..-8, D-044)
            cSpike              0.5;
            nLayers             1;
            nQuietIters         20;
            stickyAfter         3;      // never released after the 3rd entry (D-049)
            cflFactor           0.1;
            clipToNeighbourMean yes;
        }
    }

    sentinel
    {
        maxRollbacks    5;
    }

    bounds
    {
        kMin            1e-12;
        omegaMin        1e-6;
        nutMaxFactor    1e8;   // divergence guard only (D-040)
    }

    convergence
    {
        mode                any;
        forceCoeffsWindow   100;
        forceCoeffsTol      0.002;
        residualTol         1e-6;   // stops earlier on the Cd/Cl window (12.3 ii)
    }

    anderson
    {
        enabled         no;     // amendment B5
        m               4;
        beta            1.0;
    }

    ftz             yes;
    writeState      yes;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;

    // Reference converged to 1e-8 (spec 13)
    residualControl
    {
        p               1e-8;
        U               1e-8;
        "(k|omega)"     1e-8;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 3;
}

#sinclude "relaxation"     // written by Allrun from relaxation.<solver>

// ************************************************************************* //
