#!/bin/sh
#------------------------------------------------------------------------------
# Allwmake - build libcoupledFoam, the coupledFoam solver, the test apps and
# the utilities (coupledFieldCompare).
#
# Requires exactly one sourced OpenFOAM v2606 environment. Products go to
# $FOAM_USER_LIBBIN and $FOAM_USER_APPBIN only; the OpenFOAM installation is
# never written to.
#
# Usage: ./Allwmake [-j N] [-q] [-s]    (wmake options are passed through)
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

if [ -z "$WM_PROJECT_DIR" ]
then
    echo "Error: no OpenFOAM environment sourced" 1>&2
    exit 1
fi

case "$WM_PROJECT_VERSION" in
    v2606*) ;;
    *) echo "Warning: built and tested with v2606, found $WM_PROJECT_VERSION" 1>&2 ;;
esac

echo "coupledFoam: building against $WM_PROJECT_DIR ($WM_OPTIONS)"
echo "coupledFoam: products -> $FOAM_USER_LIBBIN, $FOAM_USER_APPBIN"

set -e

wmakeLnInclude -u src
wmake "$@" libso src

wmake "$@" applications/coupledFoam

for app in applications/test/Test-*
do
    [ -d "$app/Make" ] && wmake "$@" "$app"
done

for app in applications/utilities/*
do
    [ -d "$app/Make" ] && wmake "$@" "$app"
done

echo "coupledFoam: build complete"

#------------------------------------------------------------------------------
