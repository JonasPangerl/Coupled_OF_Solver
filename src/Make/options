/* Project code: warnings are errors (spec rule 0.6). OpenFOAM headers are
   included with -isystem so that their warnings do not count.
   -march=native (spec 3) can be overridden for portable binaries:
       COUPLEDFOAM_MARCH= ./Allwmake                                        */

COUPLEDFOAM_MARCH ?= -march=native
WM_OSTYPE ?= POSIX

EXE_INC = \
    -Wfloat-conversion -Werror -fno-math-errno -fopenmp-simd $(COUPLEDFOAM_MARCH) \
    -Iinclude \
    -isystem $(LIB_SRC)/OpenFOAM/lnInclude \
    -isystem $(LIB_SRC)/OSspecific/$(WM_OSTYPE)/lnInclude \
    -isystem $(LIB_SRC)/finiteVolume/lnInclude \
    -isystem $(LIB_SRC)/meshTools/lnInclude \
    -isystem $(LIB_SRC)/sampling/lnInclude \
    -isystem $(LIB_SRC)/TurbulenceModels/turbulenceModels/lnInclude \
    -isystem $(LIB_SRC)/TurbulenceModels/incompressible/lnInclude \
    -isystem $(LIB_SRC)/transportModels \
    -isystem $(LIB_SRC)/transportModels/incompressible/lnInclude \
    -isystem $(LIB_SRC)/transportModels/incompressible/singlePhaseTransportModel

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -lturbulenceModels \
    -lincompressibleTurbulenceModels \
    -lincompressibleTransportModels
